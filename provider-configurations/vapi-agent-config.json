{
  "model": {
    "provider": "openai",
    "model": "gpt-4.1-2025-04-14",
    "temperature": 0,
    "maxTokens": 1000,
    "promptCacheKey": "vapi-cekura-benchmark",
    "promptCacheRetention": "24h",
    "messages": [],
    "tools": []
  },
  "transcriber": {
    "provider": "soniox",
    "model": "stt-rt-v5",
    "language": "en",
    "customVocabulary": [
      "Cedarwood Family Clinic",
      "Dr. Lee",
      "Dr. Patel",
      "Dr. Okafor",
      "Maria Gomez",
      "James Carter",
      "Wei Chen",
      "Robert Lane",
      "reschedule",
